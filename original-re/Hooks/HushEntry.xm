// Hand-written entry point (NOT generated by tools/gen_hooks2.py).
//
// The generated Hooks.generated.xm is a pure pass-through: every one of its 309
// methods is `{ return %orig; }`, which is exactly why the recovered dylib did
// nothing.  This file is where real behaviour gets attached.
//
// We deliberately do NOT add another %hook for any host class — Hooks.generated.xm
// already hooks those, and two Logos blocks for the same class/selector collide at
// link time.  Instead we inject from a constructor plus a bounded poll, because
// the dylib constructor can run before the app has a window with a root view
// controller (that is why the ball used to appear only after backgrounding and
// returning: the become-active observer was the only path that ever fired).

#import <UIKit/UIKit.h>
#import <Foundation/Foundation.h>

#import "HushRuntime.h"
#import "HushConfig.h"
#import "HushLogger.h"

static NSInteger gHushPollTicks = 0;

// Poll: try to inject, stop as soon as a ball is actually on screen.

// Ask, after the UI has had time to lay out, which overrides the host actually
// reached. Three reports: after first frame, after the first tab switch, later.
static void HushScheduleHitReports(void) {
    static const double t[] = { 1.0, 4.0, 12.0 };
    static const char *tags[] = { "t1", "t4", "t12" };
    for (int i = 0; i < 3; i++) {
        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(t[i] * NSEC_PER_SEC)),
                       dispatch_get_main_queue(), ^{ HushHitReport(tags[i]); });
    }
}

static void HushPollInject(int64_t delayNs);

static void HushPollStep(void) {
    dispatch_async(dispatch_get_main_queue(), ^{
        static BOOL loggedPresent = NO;

        if (HushBallIsPresent()) {
            // Heartbeat: stay armed instead of stopping.  Quitting the poll the
            // first time the ball appears is what made it unrecoverable later --
            // switching tabs or rebuilding a controller removed it and nothing
            // ever put it back until the app was backgrounded.
            if (!loggedPresent) {
                loggedPresent = YES;
                NSLog(@"[Hush] ball on screen after %ld ticks (heartbeat armed)", (long)gHushPollTicks);
            }
            HushBallEnsureOnTop();          // a sheet or push can land above it
            HushPollInject((int64_t)(1.0 * NSEC_PER_SEC));
            return;
        }

        loggedPresent = NO;
        HushGalInjectBallFromKeyWindow();
        gHushPollTicks++;

        // Fast ticks first so the ball lands as soon as a window exists, then a
        // cheap 1 s heartbeat that re-attaches it after any controller rebuild.
        double delay = (gHushPollTicks <= 30) ? 0.30 : 1.00;
        if (gHushPollTicks == 31) NSLog(@"[Hush] ball still absent, switching to 1s heartbeat");
        HushPollInject((int64_t)(delay * NSEC_PER_SEC));
    });
}

static void HushPollInject(int64_t delayNs) {
    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, delayNs), dispatch_get_main_queue(), ^{
        HushPollStep();
    });
}

static void HushOnBecameActive(CFNotificationCenterRef center,
                               void *observer,
                               CFStringRef name,
                               const void *object,
                               CFDictionaryRef userInfo) {
    dispatch_async(dispatch_get_main_queue(), ^{
        if (HushBallIsPresent()) return;
        NSLog(@"[Hush] became-active -> inject");
        gHushPollTicks = 0;
        HushGalInjectBallFromKeyWindow();
        HushPollInject((int64_t)(0.30 * NSEC_PER_SEC));
    });
}

%ctor {
    CFNotificationCenterAddObserver(CFNotificationCenterGetLocalCenter(),
                                    NULL,
                                    HushOnBecameActive,
                                    CFSTR("UIApplicationDidBecomeActiveNotification"),
                                    NULL,
                                    CFNotificationSuspensionBehaviorDeliverImmediately);

    NSLog(@"[Hush] ctor ran, entry installed");
    [HushLogger logLevel:4 format:@"[Hush] entry installed (ball inject armed)"];
    // 面板上的「日志等级」开关此前是死的：+loadLevelFromConfig 从未被任何地方调用，
    // gHushLogLevel 永远停在静态初值 4 —— 表现就是 switch_debug_log=0 时 D 级照样输出、
    // 打开开关也不升高。放在 entry 那行之后调用，让 entry 无论配置如何都先落地，
    // 再按 switch_debug_log 决定后续级别（关=3 / 开=5）。
    [HushLogger loadLevelFromConfig];

    // 启动快照：把真正读到的开关值落进日志。
    // 用户报「开关开了但功能没生效」时，先看这一行是否与面板一致。
    {
        NSArray *keys = @[@"purify_master", @"switch_private_photo", @"switch_anti_recall",
                          @"switch_virtual_location", @"switch_location_sim", @"switch_altitude_sim",
                          @"switch_real_location_mask", @"switch_version_spoof",
                          @"switch_spoof_lite", @"float_ball", @"switch_debug_log"];
        NSMutableString *dump = [NSMutableString stringWithString:@"[Hush] config dump:"];
        for (NSString *k in keys) {
            [dump appendFormat:@" %@=%d", k, (int)[[HushConfig shared] isEnabled:k]];
        }
        NSLog(@"%@", dump);
        [HushLogger logLevel:3 format:dump];
    }

    // First attempt as soon as a runloop exists, then poll until it lands.
    HushPollInject((int64_t)(0.10 * NSEC_PER_SEC));

    // Which overrides did the host actually reach?  See HushHit/HushHitReport
    // in HushRuntime.m — every behaviour-bearing hook stamps a counter.
    HushInstallHooks();
    HushScheduleHitReports();
}
